%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b4899fe4290ece4a9fbb44d3960b3d5, type: 3}
  m_Name: CYFrameworkConfig
  m_EditorClassIdentifier: 
  Bootstrap:
    FixedTickRate: 60
    TargetFrameRate: 60
    VSync: 0
    RunInBackground: 1
    ScreenNeverSleep: 1
    MaxPauseTolerance: 5
  Log:
    Level: 1
    ShowTimestamp: 1
    ShowStackTrace: 1
    WriteToFile: 0
    LogFilePath: Logs/game.log
    MaxLogFileSizeMB: 10
  Audio:
    SFXPoolSize: 8
    DefaultBGMVolume: 0.8
    DefaultSFXVolume: 1
    BGMFadeTime: 0.5
  UI:
    EnablePanelPool: 1
    PanelPoolCapacity: 5
    DefaultAnimDuration: 0.25
    ToastDuration: 2
    MaxToastCount: 3
    CustomLayers: []
  Network:
    HttpTimeout: 10
    HttpMaxRetry: 3
    HeartbeatInterval: 30
    HeartbeatTimeout: 10
    MaxReconnectAttempts: 5
    ReconnectInterval: 3
    CircuitBreakerThreshold: 5
    CircuitBreakerResetTime: 30
  Save:
    SaveFileName: save.dat
    EnableEncryption: 1
    EncryptionKey: CYFramework2024!
    AutoSaveInterval: 60
    MaxSaveSlots: 3
    SaveVersion: 1
  HotUpdate:
    CdnBaseUrl: 
    VersionFileName: version.json
    DownloadTimeout: 30
    MaxConcurrentDownloads: 3
    MaxDownloadRetry: 3
    EnableIncrementalUpdate: 1
  Pool:
    DefaultInitialCapacity: 16
    DefaultMaxCapacity: 256
    DefaultWarmupCount: 8
    CleanupInterval: 60
    IdleTimeout: 120
    PoolGroups:
    - Bullets
    - Effects
    - UI
    - Audio
    - Misc
  Entity:
    DefaultPreloadCount: 5
    MaxPoolSize: 100
    UpdateInterval: 1
    EntityGroups:
    - Players
    - Enemies
    - NPCs
    - Props
    - Effects
    - Projectiles
    - Items
  Resource:
    LoadMode: 0
    AddressablesLabel: default
    CacheSizeMB: 100
    AsyncLoadPriority: 100
    EnableRefCount: 1
    UIPanelPath: UI/
    EntityPath: Entities/
    AudioPath: Audio/
    BGMPath: Audio/BGM/
    SFXPath: Audio/SFX/
    SpritePath: Sprites/
    IconPath: Sprites/Icons/
    PrefabPath: Prefabs/
    EffectPath: Effects/
    ConfigPath: Config/
    MaterialPath: Materials/
    AnimationPath: Animations/
    ScenePath: Scenes/
  Timer:
    InitialCapacity: 32
    UseUnscaledTime: 0
  Procedure:
    EntryProcedure: 
    AutoRegisterProcedures: 1
  Debug:
    EnableConsole: 1
    ConsoleToggleKey: 96
    ShowFPS: 1
    ShowMemory: 1
    EnableGMCommands: 1
